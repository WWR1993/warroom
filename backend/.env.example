# Example environment variables for Warroom backend

# Postgres connection string (required)
DATABASE_URL=postgres://warroom:warroom@localhost:5432/warroom

# Poll interval in seconds
POLL_INTERVAL=60

# CORS origin for frontend (use your frontend domain or * for testing)
FRONTEND_ORIGIN=*

# Comma or newline separated feeds. Each entry may be 'url' or 'url|source'
FEEDS=https://example.com/mock-rss.xml|MockFeed
